{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DatasetImageSummary",
  "type": "object",
  "required": [
    "datasetId",
    "matchingImageCount",
    "totalImageCount",
    "imageIds"
  ],
  "properties": {
    "datasetId": {
      "type": "string",
      "description": "Unique identifier of the dataset"
    },
    "datasetTitle": {
      "type": "string",
      "description": "Dataset title"
    },
    "datasetDescription": {
      "type": "string",
      "description": "Dataset description"
    },
    "totalImageCount": {
      "type": "integer",
      "description": "Total number of images in the dataset"
    },
    "matchingImageCount": {
      "type": "integer",
      "description": "Number of images in the dataset that match the query filters"
    },
    "imageIds": {
      "type": "array",
      "description": "Optional and possible incomplete List of matching image identifiers",
      "items": {
        "type": "string"
      }
    }
  }
}
