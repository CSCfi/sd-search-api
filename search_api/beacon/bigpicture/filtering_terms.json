{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_comment": "Partial implementation of the Beacon V2 framework standard: https://docs.genomebeacons.org/framework/.",
  "meta": {
    "apiVersion": "v2.0",
    "beaconId": "fi.csc.bigpicture.beacon.v2"
  },
  "response": {
    "filteringTerms": [
      {
        "id": "dataset_title",
        "type": "alphanumeric"
      },
      {
        "id": "dataset_description",
        "type": "alphanumeric"
      },
      {
        "id": "animal_species",
        "type": "SNOMED CT"
      },
      {
        "id": "anatomical_site",
        "type": "SNOMED CT"
      },
      {
        "id": "sex",
        "type": "alphanumeric"
      },
      {
        "id": "fixation_type",
        "type": "SNOMED CT"
      },
      {
        "id": "block_preparation",
        "type": "SNOMED CT"
      },
      {
        "id": "specimen_type",
        "type": "SNOMED CT"
      },
      {
        "id": "staining_method",
        "type": "alphanumeric"
      },
      {
        "id": "staining_procedure",
        "type": "SNOMED CT"
      },
      {
        "id": "staining_target",
        "type": "alphanumeric"
      },
      {
        "id": "staining_compound",
        "type": "alphanumeric"
      },
      {
        "id": "age_at_extraction",
        "type": "alphanumeric"
      }
    ]
  }
}
