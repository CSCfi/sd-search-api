<OBSERVATION_SET xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <!-- One observation per reference type (image, slide, block, specimen, biological being,
         case) while mixing statement statuses (Distinct, Summary).

         Both images share the same specimen, block, biological being, and
         case — only the slide is different. An observation referencing a
         specimen, block, biological being, and case is linked to both images.
         An observation referencing a slide or image is linked to one image.
    -->

    <!-- CASE_REF, Distinct: reaches both images. Has two codes; the
         non-SNOMED one is ignored. -->
    <OBSERVATION alias="1">
        <CASE_REF alias="1"/>
        <STATEMENT>
            <STATEMENT_TYPE>Diagnosis</STATEMENT_TYPE>
            <STATEMENT_STATUS>Distinct</STATEMENT_STATUS>
            <CODE_ATTRIBUTES>
                <CODE_ATTRIBUTE>
                    <TAG>diagnosis</TAG>
                    <VALUE>
                        <CODE>254837009</CODE>
                        <SCHEME>SNOMED CT</SCHEME>
                        <MEANING>Malignant neoplasm of breast (disorder)</MEANING>
                        <SCHEME_VERSION/>
                    </VALUE>
                </CODE_ATTRIBUTE>
                <CODE_ATTRIBUTE>
                    <TAG>diagnosis</TAG>
                    <VALUE>
                        <CODE>8500/3</CODE>
                        <SCHEME>ICDO</SCHEME>
                        <MEANING>Infiltrating duct carcinoma, NOS</MEANING>
                        <SCHEME_VERSION/>
                    </VALUE>
                </CODE_ATTRIBUTE>
            </CODE_ATTRIBUTES>
            <CUSTOM_ATTRIBUTES xsi:nil="true"/>
            <FREETEXT xsi:nil="true"/>
            <ATTRIBUTES xsi:nil="true"/>
        </STATEMENT>
        <ATTRIBUTES xsi:nil="true"/>
    </OBSERVATION>

